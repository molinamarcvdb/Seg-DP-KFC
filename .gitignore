# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data files (large datasets)
/data/

# Output files (model checkpoints, results)
outputs/

# Logs (experiment logs, can be very large)
logs/

# Generated figures (can be regenerated)
figures/

# Large model files
*.pt
*.pth
*.ckpt
*.safetensors
*.bin

# Large data files
*.npz
*.npy
*.h5
*.hdf5
*.parquet
*.pkl
*.pickle
*.tar
*.tar.gz
*.zip

# Medical imaging formats
*.nii
*.nii.gz
*.dcm

# Paper sub-repo (has its own git)
paper/dp_shampoo_repo/

# Condor runtime artifacts
condor/log/
condor/output/
condor/error/

# Exported requirements (regenerable)
requirements.txt

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# IDE
.idea/
.vscode/
*.swp
*.swo
